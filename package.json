{
  "name": "@local/skills-manager",
  "version": "0.3.4",
  "type": "module",
  "description": "Visual Skills Manager for DeepSeek Harness: Inspect, create, edit local skills, and configure model/user invocation policies in Settings.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daha1216/dsh-skills-manager.git"
  },
  "homepage": "https://github.com/daha1216/dsh-skills-manager#readme",
  "bugs": {
    "url": "https://github.com/daha1216/dsh-skills-manager/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "assets/**",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
